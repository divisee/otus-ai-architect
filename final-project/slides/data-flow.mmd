flowchart TB
    subgraph IN["Ingest"]
        PDF[PDF / MD + МКБ CSV] --> PARSE[парсинг + чанки]
        PARSE --> META[acl из манифеста]
        META --> EMB[bge-m3]
        EMB --> QD[(Qdrant)]
        META --> EXT[узлы и рёбра]
        EXT --> NEO[(Neo4j)]
    end
    subgraph RT["Runtime"]
        U[Речь или текст] --> ASR[ASR]
        ASR --> GW[Gateway + actor]
        GW --> SAN[PII → токены]
        GW --> REL[свои + GUARDIAN_OF]
        SAN --> RET[graph + vector ∩ ACL]
        REL --> RET
        RET --> LOOP[Agent + tools]
        LOOP --> GEN[vLLM]
        GEN --> DLP[тайна, grounding]
        DLP --> OUT[текст / TTS]
    end
    QD --> RET
    NEO --> RET
    CRM[(CRM)] --> LOOP
