%% Мультиагентная схема: оркестратор, субагенты, инструменты (ADR-0008)
flowchart TB
    IN[Реплика: голос или чат] --> IG[Input Guardrails<br/>инъекции, запрос диагноза, ПДн]

    subgraph ORCH["Оркестратор · LangGraph — одна машина состояний"]
        IG --> MEM[Memory<br/>сессия, actor_id, subject_id]
        MEM --> RTR{Router<br/>knowledge / crm / both / reject}
        FIN[Final<br/>сборка допущенного контекста]
        GEN[Generator · vLLM<br/>только допущенный контекст]
        OG[Output Guardrails<br/>чужое ФИО, диагноз, опора]
    end

    subgraph SUB["Субагенты — узлы того же графа, не автономные агенты"]
        KN[Knowledge<br/>поиск знаний клиники]
        CRMA[CRM Agent<br/>слоты, запись, перенос, отмена]
        POL[Policy Gate<br/>проверка прав, без модели]
    end

    subgraph TOOLS["Инструменты, закреплённые за субагентами"]
        T1[[graph_search · чтение]]
        T2[[vector_search · чтение]]
        T3[[list_slots · чтение]]
        T4[[book / reschedule / cancel · запись + HITL]]
        T5[[escalate_operator]]
    end

    RTR -->|knowledge / both| KN
    RTR -->|crm / both| CRMA
    RTR -->|reject| OG

    KN --> T1
    KN --> T2
    KN --> POL
    CRMA --> POL
    POL -->|допущено| T3
    POL -->|допущено после «да»| T4
    POL -->|отказ| FIN
    CRMA -->|нет подтверждения| T5

    KN --> FIN
    CRMA --> FIN
    FIN --> GEN
    GEN --> OG
    OG --> OUT[Ответ: текст или синтез речи]
